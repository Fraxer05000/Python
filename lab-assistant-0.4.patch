+++ b/apps/backend/q_backend/controllers/lab.py
@@ -0,0 +1,117 @@
+"""Project-scoped laboratory ledger backed by the existing persistent memory."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from datetime import UTC, datetime
+from typing import Any
+from uuid import uuid4
+
+from sqlalchemy import select
+
+from q_backend.controllers.base import BaseController, ControllerResult
+from q_backend.errors import QError, QErrorCode
+from q_backend.memory.service import MemoryService
+from q_backend.models.memory import MemoryScope
+from q_backend.models.permissions import InvocationIdentity
+from q_backend.projects.service import ProjectService
+from q_backend.storage.database import Database, MemoryRecordRow
+
+
+class LabController(BaseController):
+    def __init__(self, database: Database, memory: MemoryService, projects: ProjectService) -> None:
+        self._database = database
+        self._memory = memory
+        self._projects = projects
+
+    def argument_schema(self, method: str) -> dict[str, Any]:
+        properties: dict[str, Any] = {}
+        required: list[str] = []
+        if method == "record":
+            properties = {
+                "kind": {"enum": ["progress", "inventory", "equipment", "observation"]},
+                "title": {"type": "string", "minLength": 1, "maxLength": 160},
+                "notes": {"type": "string", "maxLength": 12000},
+                "source": {"type": "string", "maxLength": 500},
+                "status": {"enum": ["open", "completed", "attention"]},
+                "quantity": {"type": "number", "minimum": 0, "maximum": 1000000000},
+                "minimum": {"type": "number", "minimum": 0, "maximum": 1000000000},
+                "unit": {"type": "string", "maxLength": 30},
+                "due_date": {"type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"},
+            }
+            required = ["kind", "title", "notes", "source", "status"]
+        elif method != "list":
+            raise QError(QErrorCode.VALIDATION_ERROR, "Unknown laboratory operation.")
+        return {
+            "type": "object",
+            "properties": properties,
+            "required": required,
+            "additionalProperties": False,
+        }
+
+    async def normalize_arguments(
+        self,
+        method: str,
+        arguments: dict[str, Any],
+        identity: InvocationIdentity,
+    ) -> dict[str, Any]:
+        if identity.project_id is None:
+            raise QError(QErrorCode.VALIDATION_ERROR, "Selecciona un proyecto de laboratorio.")
+        await self._projects.get(identity.project_id)
+        normalized = dict(arguments)
+        normalized["_policy"] = {"resource": identity.project_id}
+        return normalized
+
+    async def invoke(
+        self,
+        method: str,
+        arguments: dict[str, Any],
+        identity: InvocationIdentity,
+    ) -> ControllerResult:
+        if identity.project_id is None:
+            raise QError(QErrorCode.VALIDATION_ERROR, "A project is required.")
+        if method == "record":
+            record = {key: value for key, value in arguments.items() if not key.startswith("_")}
+            if not str(record["title"]).strip():
+                raise QError(QErrorCode.VALIDATION_ERROR, "El título no puede estar vacío.")
+            due = record.get("due_date")
+            if due:
+                try:
+                    datetime.strptime(str(due), "%Y-%m-%d")
+                except ValueError as exc:
+                    raise QError(QErrorCode.VALIDATION_ERROR, "Fecha inválida.") from exc
+            record["entry_id"] = str(uuid4())
+            record["recorded_at_utc"] = datetime.now(UTC).isoformat()
+            saved = await self._memory.save(
+                scope=MemoryScope.PROJECT,
+                content=json.dumps(record, ensure_ascii=False),
+                source="lab-ledger:" + str(record["entry_id"]),
+                project_id=identity.project_id,
+                user_id=identity.user_id,
+                sensitivity=False,
+            )
+            return ControllerResult(
+                data=record,
+                resource=identity.project_id,
+                provenance_outputs=[{"memory_id": str(saved.memory_id)}],
+            )
+        if method == "list":
+            entries = await asyncio.to_thread(self._list, identity)
+            return ControllerResult(data={"entries": entries}, resource=identity.project_id)
+        raise QError(QErrorCode.VALIDATION_ERROR, "Unknown laboratory operation.")
+
+    def _list(self, identity: InvocationIdentity) -> list[dict[str, Any]]:
+        with self._database.session() as session:
+            rows = session.scalars(
+                select(MemoryRecordRow)
+                .where(
+                    MemoryRecordRow.project_id == identity.project_id,
+                    MemoryRecordRow.user_id == identity.user_id,
+                    MemoryRecordRow.source.startswith("lab-ledger:"),
+                    MemoryRecordRow.deleted.is_(False),
+                )
+                .order_by(MemoryRecordRow.created_at_utc.desc())
+                .limit(500)
+            ).all()
+            return [json.loads(row.content) for row in rows]
