+from __future__ import annotations
+
+import importlib
+import io
+import json
+
+import pytest
+
+
+@pytest.mark.parametrize("worker_name", ["audio_worker", "python_worker", "sql_worker"])
+def test_worker_json_preserves_unicode_with_windows_pipe_encoding(
+    worker_name: str, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    worker = importlib.import_module(f"runtimes.{worker_name}.main")
+    value: dict[str, object] = {"status": "ok", "text": "bitácora µ Ω"}
+    buffer = io.BytesIO()
+    with io.TextIOWrapper(buffer, encoding="cp1252") as stdout:
+        with monkeypatch.context() as patch:
+            patch.setattr(worker.sys, "stdout", stdout)
+            result = worker._emit(value)
+            stdout.flush()
+        encoded = buffer.getvalue()
+
+    assert result == 0
+    assert encoded.isascii()
+    assert json.loads(encoded.decode("utf-8")) == value
