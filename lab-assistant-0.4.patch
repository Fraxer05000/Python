+import { useEffect, useRef, useState } from "react";
+import { invokeTool, type BackendConnection, type PermissionChallenge, type Project, type ToolResult } from "./api";
+
+export interface LabEntry {
+  entry_id: string; recorded_at_utc: string; kind: string; title: string; notes: string;
+  status: string; source: string; quantity?: number; minimum?: number; unit?: string; due_date?: string;
+}
+export type PermissionHandler = (challenge: PermissionChallenge, after?: (result: ToolResult) => Promise<void>) => void;
+const labels: Record<string, string> = { progress: "Avance", inventory: "Inventario", equipment: "Mantenimiento", observation: "Observación" };
+
+export function LabView({ connection, project, requestPermission }: {
+  connection?: BackendConnection; project: Project | null; requestPermission: PermissionHandler;
+}) {
+  const [entries, setEntries] = useState<LabEntry[]>([]);
+  const [kind, setKind] = useState("progress");
+  const [title, setTitle] = useState("");
+  const [notes, setNotes] = useState("");
+  const [source, setSource] = useState("");
+  const [status, setStatus] = useState("open");
+  const [quantity, setQuantity] = useState(0);
+  const [minimum, setMinimum] = useState(0);
+  const [unit, setUnit] = useState("unidades");
+  const [due, setDue] = useState("");
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState(false);
+  const currentProject = useRef(project?.project_id);
+  currentProject.current = project?.project_id;
+  const refresh = async () => {
+    if (!connection || !project) { setEntries([]); return; }
+    const r = await invokeTool(connection, project.project_id, "lab.list", {}, "Consultar la bitácora del proyecto");
+    if (currentProject.current !== project.project_id) return;
+    if (r.status === "ok") setEntries((r.data as {entries: LabEntry[]}).entries);
+    else setError(r.error?.message ?? "No se pudo leer la bitácora");
+  };
+  useEffect(() => { setEntries([]); void refresh().catch(e => setError(String(e))); }, [connection?.port, project?.project_id]);
+  const save = async () => {
+    if (!connection || !project) return;
+    setBusy(true); setError("");
+    try {
+      const args = { kind, title, notes, source: source || "Registro explícito del usuario", status, due_date: due,
+        ...(kind === "inventory" ? { quantity, minimum, unit } : {}) };
+      const after = async () => { setTitle(""); setNotes(""); await refresh(); };
+      const r = await invokeTool(connection, project.project_id, "lab.record", args, "Guardar este registro en la memoria del laboratorio");
+      if (r.status === "confirmation_required") requestPermission(r.data as PermissionChallenge, after);
+      else if (r.status === "ok") await after();
+      else setError(r.error?.message ?? "No se pudo guardar");
+    } catch (e) { setError(String(e)); } finally { setBusy(false); }
+  };
+  const latest = entries.filter((e, i, all) => all.findIndex(x => x.kind === e.kind && x.title.toLocaleLowerCase() === e.title.toLocaleLowerCase()) === i);
+  const today = new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0,10);
+  const alerts = latest.filter(e => e.status !== "completed" && ((e.due_date && e.due_date <= today) ||
+    (e.kind === "inventory" && e.quantity !== undefined && e.minimum !== undefined && e.quantity <= e.minimum) || e.status === "attention"));
+  return <section className="panel lab-panel">
+    <h2>Laboratorio</h2><p>Bitácora, existencias y mantenimiento de {project?.name ?? "un proyecto por seleccionar"}. Los registros se conservan localmente y Q puede consultarlos.</p>
+    {alerts.length > 0 && <div className="notice"><div><strong>Revisiones pendientes</strong>{alerts.map(e => <p key={e.entry_id}>{e.title} · {e.due_date || "Existencias o atención pendiente"}</p>)}</div></div>}
+    <div className="lab-grid"><div className="stack-form">
+      <label>Tipo<select value={kind} onChange={e => setKind(e.target.value)}>{Object.entries(labels).map(([k,v]) => <option key={k} value={k}>{v}</option>)}</select></label>
+      <label>Título<input value={title} maxLength={160} onChange={e => setTitle(e.target.value)} /></label>
+      <label>Observaciones y avances<textarea value={notes} maxLength={12000} onChange={e => setNotes(e.target.value)} placeholder="Registra lo observado, las unidades y lo pendiente. Distingue datos de hipótesis." /></label>
+      <label>Fuente, equipo o manual<input value={source} maxLength={500} onChange={e => setSource(e.target.value)} /></label>
+      {kind === "inventory" && <div className="lab-grid"><label>Cantidad<input type="number" min="0" value={quantity} onChange={e => setQuantity(Number(e.target.value))} /></label><label>Mínimo<input type="number" min="0" value={minimum} onChange={e => setMinimum(Number(e.target.value))} /></label><label>Unidad<input value={unit} onChange={e => setUnit(e.target.value)} /></label></div>}
+      <label>Fecha de revisión<input type="date" value={due} onChange={e => setDue(e.target.value)} /></label>
+      <label>Estado<select value={status} onChange={e => setStatus(e.target.value)}><option value="open">Pendiente</option><option value="completed">Completado</option><option value="attention">Requiere atención</option></select></label>
+      <button disabled={!project || !title.trim() || busy} onClick={() => void save()}>Guardar en memoria</button>
+      {error && <p role="alert">{error}</p>}
+    </div><div className="lab-ledger"><h3>Registros recientes</h3><p>Para actualizar existencias o mantenimiento, añade un registro con el mismo título. El historial se conserva.</p>
+      {entries.map(e => <article className="artifact" key={e.entry_id}><span>{labels[e.kind]} · {new Date(e.recorded_at_utc).toLocaleString()}</span><strong>{e.title}</strong><p>{e.notes}</p>{e.quantity !== undefined && <small>{e.quantity} {e.unit}</small>}<small>{e.status} · {e.source}</small></article>)}
+      {!entries.length && <p>Aún no hay registros en este proyecto.</p>}
+    </div></div>
+  </section>;
+}
+
+export function DevicesView({ connection, requestPermission }: {connection?: BackendConnection; requestPermission: PermissionHandler}) {
+  const [devices, setDevices] = useState<Array<{id:string;name:string;category:string;status:string;capability:string}>>([]);
+  const [notice, setNotice] = useState("");
+  const [busy, setBusy] = useState(false);
+  const scan = async () => {
+    if (!connection) return;
+    setBusy(true); setNotice("");
+    const accept = async (r: ToolResult) => { setDevices((r.data as {devices: typeof devices}).devices); };
+    try {
+      const r = await invokeTool(connection, null, "devices.list", {}, "Consultar los dispositivos USB, Bluetooth, cámara y audio de Windows");
+      if (r.status === "confirmation_required") requestPermission(r.data as PermissionChallenge, accept);
+      else if (r.status === "ok") await accept(r);
+      else setNotice(r.error?.message ?? "No se pudo consultar");
+    } catch(e) { setNotice(String(e)); } finally { setBusy(false); }
+  };
+  return <section className="panel"><h2>Dispositivos</h2><p>La cámara y el micrófono se activan desde sus controles. Esta consulta no instala drivers ni envía órdenes a instrumentos.</p>
+    <button onClick={() => void scan()} disabled={busy || !connection}>{busy ? "Consultando…" : "Detectar dispositivos"}</button><p role="status">{notice}</p>
+    <div className="lab-ledger">{devices.map(d => <article className="artifact" key={d.id}><strong>{d.name}</strong><small>{d.category} · {d.status}</small><p>{d.capability}</p></article>)}</div>
+    <h3>Impresora y mecatrónica</h3><p>EasyThreed: modelo exacto, interfaz de datos y protocolo pendientes de verificar con el equipo conectado. No se presupone Bluetooth. Los brazos personalizados requieren firmware, límites mecánicos y una parada física antes de habilitar movimientos.</p>
+  </section>;
+}
