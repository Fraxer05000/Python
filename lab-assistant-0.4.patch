+      if(current!==generation.current)return;
+      running.current=true;starting.current=false;setActive(true);setLoading(false);
+      const detect=async()=>{
+        if(!running.current||current!==generation.current||!video.current||!model.current)return;
+        try{
+          const before=performance.now();
+          inFlight.current=model.current.detect(video.current,12,0.6);
+          const found=await inFlight.current;
+          if(!running.current||current!==generation.current)return;
+          setElapsed(Math.round(performance.now()-before));setObjects(found);
+          const surface=canvas.current;const ctx=surface?.getContext("2d");
+          if(surface&&ctx){surface.width=video.current.videoWidth;surface.height=video.current.videoHeight;ctx.clearRect(0,0,surface.width,surface.height);ctx.font="16px sans-serif";ctx.strokeStyle="#40e6ad";ctx.fillStyle="#40e6ad";ctx.lineWidth=2;for(const item of found){ctx.strokeRect(...item.bbox);ctx.fillText(`${names[item.class]??item.class} ${Math.round(item.score*100)}%`,item.bbox[0]+4,Math.max(18,item.bbox[1]-5));}}
+        }catch(e){if(current===generation.current){setNotice(String(e));stop();}return;}
+        if(running.current&&current===generation.current)timer.current=setTimeout(()=>void detect(),1500);
+      };
+      void detect();
+    }catch(e){if(current===generation.current){setNotice(e instanceof Error?e.message:"No se pudo activar la cámara");stop();}}
+  };
+  const save=async()=>{
+    if(!connection||!project)return;
+    try{
+      const observed=objects.map(x=>`${names[x.class]??x.class} (${Math.round(x.score*100)}%)`).join(", ");
