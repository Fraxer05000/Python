@@ -0,0 +1,99 @@
+import { useEffect, useRef, useState } from "react";
+import type { DetectedObject, ObjectDetection } from "@tensorflow-models/coco-ssd";
+import { invokeTool, type BackendConnection, type PermissionChallenge, type Project } from "./api";
+import type { PermissionHandler } from "./LabView";
+
+const names: Record<string,string> = { bottle:"botella", cup:"taza o recipiente", scissors:"tijeras", person:"persona", chair:"silla", "dining table":"mesa", laptop:"portátil", mouse:"ratón", keyboard:"teclado", book:"libro", "cell phone":"teléfono", tv:"pantalla", sink:"lavabo", refrigerator:"refrigerador", bowl:"recipiente" };
+export function CameraView({connection,project,requestPermission}: {connection?:BackendConnection;project:Project|null;requestPermission:PermissionHandler}) {
+  const video = useRef<HTMLVideoElement>(null);
+  const canvas = useRef<HTMLCanvasElement>(null);
+  const stream = useRef<MediaStream|null>(null);
+  const model = useRef<ObjectDetection|null>(null);
+  const modelLoading = useRef<Promise<void>|null>(null);
+  const running = useRef(false);
+  const starting = useRef(false);
+  const inFlight = useRef<Promise<DetectedObject[]> | null>(null);
+  const generation = useRef(0);
+  const timer = useRef<ReturnType<typeof setTimeout>|null>(null);
+  const [active,setActive] = useState(false);
+  const [loading,setLoading] = useState(false);
+  const [notice,setNotice] = useState("");
+  const [objects,setObjects] = useState<DetectedObject[]>([]);
+  const [correction,setCorrection] = useState("");
+  const [elapsed,setElapsed] = useState(0);
+  const stop = () => {
+    generation.current++; running.current=false; starting.current=false;
+    if(timer.current)clearTimeout(timer.current);
+    stream.current?.getTracks().forEach(t=>t.stop());stream.current=null;
+    if(video.current)video.current.srcObject=null;
+    setActive(false);setLoading(false);
+  };
+  useEffect(()=>()=>{
+    stop();
+    const loaded = model.current; model.current = null;
+    if (inFlight.current) void inFlight.current.catch(()=>undefined).then(()=>loaded?.dispose());
+    else loaded?.dispose();
+  },[]);
+  const start = async () => {
+    if (running.current || starting.current) return;
+    starting.current=true;
+    const current=++generation.current;
+    setLoading(true);setNotice("");setObjects([]);
+    try {
+      const media=await navigator.mediaDevices.getUserMedia({video:{width:{ideal:640},height:{ideal:480},frameRate:{ideal:10,max:15}},audio:false});
+      if(current!==generation.current){media.getTracks().forEach(t=>t.stop());return;}
+      stream.current=media;
+      if(!video.current)throw new Error("La vista de cámara no está disponible");
+      video.current.srcObject=media;await video.current.play();
+      await inFlight.current?.catch(()=>undefined);
+      await modelLoading.current?.catch(()=>undefined);
+      if(current!==generation.current)return;
+      if(!model.current){
+        const pending=(async()=>{
+          await import("@tensorflow/tfjs-backend-cpu");await import("@tensorflow/tfjs-backend-webgl");
+          const tf=await import("@tensorflow/tfjs-core");
+          try{if(!await tf.setBackend("webgl")) await tf.setBackend("cpu");}catch{await tf.setBackend("cpu");}await tf.ready();
+          const coco=await import("@tensorflow-models/coco-ssd");
+          const loaded=await coco.load({base:"lite_mobilenet_v2",modelUrl:"/vision/model.json"});
+          if(current!==generation.current)loaded.dispose();
+          else model.current=loaded;
+        })();
+        modelLoading.current=pending;
+        try{await pending;}finally{if(modelLoading.current===pending)modelLoading.current=null;}
+      }
+      if(current!==generation.current)return;
+      running.current=true;starting.current=false;setActive(true);setLoading(false);
+      const detect=async()=>{
+        if(!running.current||current!==generation.current||!video.current||!model.current)return;
+        try{
+          const before=performance.now();
+          inFlight.current=model.current.detect(video.current,12,0.6);
+          const found=await inFlight.current;
+          if(!running.current||current!==generation.current)return;
+          setElapsed(Math.round(performance.now()-before));setObjects(found);
+          const surface=canvas.current;const ctx=surface?.getContext("2d");
+          if(surface&&ctx){surface.width=video.current.videoWidth;surface.height=video.current.videoHeight;ctx.clearRect(0,0,surface.width,surface.height);ctx.font="16px sans-serif";ctx.strokeStyle="#40e6ad";ctx.fillStyle="#40e6ad";ctx.lineWidth=2;for(const item of found){ctx.strokeRect(...item.bbox);ctx.fillText(`${names[item.class]??item.class} ${Math.round(item.score*100)}%`,item.bbox[0]+4,Math.max(18,item.bbox[1]-5));}}
+        }catch(e){if(current===generation.current){setNotice(String(e));stop();}return;}
+        if(running.current&&current===generation.current)timer.current=setTimeout(()=>void detect(),1500);
+      };
+      void detect();
+    }catch(e){if(current===generation.current){setNotice(e instanceof Error?e.message:"No se pudo activar la cámara");stop();}}
+  };
+  const save=async()=>{
+    if(!connection||!project)return;
+    try{
+      const observed=objects.map(x=>`${names[x.class]??x.class} (${Math.round(x.score*100)}%)`).join(", ");
+      const result=await invokeTool(connection,project.project_id,"lab.record",{kind:"observation",title:"Observación visual",notes:`Detección automática orientativa: ${observed||"sin detecciones"}.\nRevisión del usuario: ${correction}`,source:"Cámara local · COCO-SSD · objeto general, sin identificación de sustancias",status:"open"},"Guardar la observación visual revisada en la bitácora");
+      if(result.status==="confirmation_required")requestPermission(result.data as PermissionChallenge,async()=>{setNotice("Observación guardada en la memoria del proyecto.");});
+      else if(result.status==="ok")setNotice("Observación guardada.");else setNotice(result.error?.message??"No se pudo guardar");
+    }catch(e){setNotice(String(e));}
+  };
+  const suggestions=objects.some(x=>x.class==="bottle")?["Comprueba la etiqueta y el identificador antes de vincular el recipiente al inventario."]:objects.some(x=>x.class==="book")?["Añade el manual al conocimiento del proyecto para que Q pueda consultarlo con su fuente."]:["Asocia las observaciones al proyecto, fecha e identificador del material."];
+  return <section className="panel"><h2>Cámara del laboratorio</h2><p>Procesamiento local. No se graban ni se envían imágenes. Reconoce 80 clases de objetos generales; el material especializado requiere revisión.</p>
+    <div className="camera-controls"><button onClick={()=>void start()} disabled={active||loading}>{loading?"Cargando reconocimiento local…":"Activar cámara"}</button><button onClick={stop} disabled={!active&&!loading}>Apagar cámara</button><span>{active?`Cámara activa · última inferencia ${elapsed} ms`:"Cámara apagada"}</span></div>
+    <div className="camera-frame"><video ref={video} muted playsInline/><canvas ref={canvas}/></div>
+    <p role="status">{notice}</p><p>No identifica sustancias, microorganismos, esterilidad ni condiciones seguras de un ensayo.</p>
+    <div className="lab-grid"><div><h3>Observaciones orientativas</h3>{objects.map((o,i)=><p key={i}>{names[o.class]??o.class} · {Math.round(o.score*100)}%</p>)}{active&&!objects.length&&<p>Sin objetos reconocidos con suficiente confianza.</p>}</div><div><h3>Sugerencias de registro</h3>{suggestions.map(s=><p key={s}>{s}</p>)}</div></div>
+    <label>Revisión del usuario<textarea value={correction} onChange={e=>setCorrection(e.target.value)} placeholder="Confirma o corrige lo observado antes de guardarlo"/></label><button disabled={!project||!correction.trim()} onClick={()=>void save()}>Guardar observación revisada</button>
+  </section>;
+}
