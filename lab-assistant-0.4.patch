diff --git a/tests/integration/test_lab_chat.py b/tests/integration/test_lab_chat.py
new file mode 100644
--- /dev/null
+++ b/tests/integration/test_lab_chat.py
@@ -0,0 +1,128 @@
+from __future__ import annotations
+
+from typing import Any, cast
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from q_backend.container import AppContainer
+from q_backend.models.runtime import InferenceRequest, InferenceResponse, ToolCall
+from q_backend.orchestrator.service import ChatOrchestrator, _explicit_lab_action
+from q_backend.runtimes.base import ModelRuntimeAdapter
+
+
+class LabRequestRuntime:
+    def __init__(self, project_id: str) -> None:
+        self.project_id = project_id
+        self.calls = 0
+
+    async def generate(self, request: InferenceRequest) -> InferenceResponse:
+        self.calls += 1
+        assert request.tool_choice == "required"
+        schema = request.tools[0]["function"]["parameters"]["properties"]
+        assert schema["tool"]["enum"] == ["lab.record"]
+        assert schema["arguments"]["properties"]["kind"]["enum"] == ["progress"]
+        assert "notes" in schema["arguments"]["required"]
+        return InferenceResponse(
+            request_id=request.request_id,
+            content=None,
+            tool_calls=[
+                ToolCall(
+                    id="lab-call",
+                    name="q_tool_request",
+                    arguments={
+                        "request_id": "12345678-90ab-cdef-0123-456789abcdef",
+                        "tool": "lab.record",
+                        "arguments": {
+                            "kind": "progress",
+                            "title": "Revisión de inventario",
+                            "notes": "Se revisaron tres recipientes",
+                            "source": "Usuario",
+                            "status": "completed",
+                        },
+                        "reason": "Guardar el avance solicitado",
+                        "project_id": self.project_id,
+                    },
+                )
+            ],
+        )
+
+
+@pytest.mark.parametrize("allow", [True, False])
+def test_lab_chat_confirms_once_with_preview_and_no_second_inference(
+    client: TestClient,
+    allow: bool,
+) -> None:
+    project = client.post("/api/v1/projects", json={"name": "Registro"}).json()["project_id"]
+    session = client.post("/api/v1/chat/sessions", json={"project_id": project}).json()[
+        "session_id"
+    ]
+    runtime = LabRequestRuntime(project)
+    container = cast(AppContainer, cast(FastAPI, client.app).state.container)
+    container.chat._runtime = cast(ModelRuntimeAdapter, runtime)
+    turn = client.post(
+        "/api/v1/chat/turn",
+        json={
+            "session_id": session,
+            "project_id": project,
+            "message": "Registra un avance: revisión de inventario",
+        },
+    ).json()
+    assert turn["status"] == "confirmation_required"
+    pending = turn["pending_tool_result"]["data"]
+    assert pending["preview"]["notes"] == "Se revisaron tres recipientes"
+    assert "_policy" not in pending["preview"]
+    assert pending["request_id"] != "12345678-90ab-cdef-0123-456789abcdef"
+    result = client.post(
+        "/api/v1/chat/permissions/confirm",
+        json={
+            "challenge_id": pending["challenge_id"],
+            "confirmation_secret": pending["confirmation_secret"],
+            "allow": allow,
+        },
+    ).json()
+    assert result["status"] == "completed"
+    assert runtime.calls == 1
+    if allow:
+        assert result["answer"].startswith("Guardé")
+        assert result["actions"][0]["audit_id"] and result["actions"][0]["provenance_id"]
+    else:
+        assert result["answer"].startswith("No guardé")
+    # A subsequent request can reuse the model's example UUID without a challenge collision.
+    second = client.post(
+        "/api/v1/chat/turn",
+        json={
+            "session_id": session,
+            "project_id": project,
+            "message": "Registra un avance: segunda revisión",
+        },
+    ).json()
+    assert second["status"] == "confirmation_required"
+    assert second["pending_tool_result"]["request_id"] != pending["request_id"]
+
+
+@pytest.mark.parametrize(
+    "message",
+    [
+        "No registres el avance",
+        "¿Cómo guardo el inventario?",
+        '"Registra un avance" es un ejemplo',
+        "Consulta este texto: registra un avance",
+        "Guarda mi preferencia de voz",
+    ],
+)
+def test_lab_command_routing_does_not_force_questions_or_quoted_text(message: str) -> None:
+    assert _explicit_lab_action(message) is None
+
+
+def test_model_cannot_change_project_and_correlation_is_host_owned() -> None:
+    request: dict[str, Any] = {
+        "request_id": "12345678-90ab-cdef-0123-456789abcdef",
+        "tool": "lab.list",
+        "arguments": {},
+        "reason": "Consultar",
+        "project_id": None,
+    }
+    first = ChatOrchestrator._validate_tool_call("q_tool_request", request, None)
+    second = ChatOrchestrator._validate_tool_call("q_tool_request", request, None)
+    assert first.request_id != second.request_id
