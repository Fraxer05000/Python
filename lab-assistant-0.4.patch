+from __future__ import annotations
+
+import json
+from uuid import uuid4
+
+import pytest
+from q_backend.errors import QError
+from q_backend.models.runtime import ChatMessage
+from q_backend.models.tool import ToolResult, ToolStatus
+from q_backend.orchestrator.context import ContextBuilder
+from q_backend.orchestrator.service import _bounded_result
+
+
+def test_large_memory_and_old_tool_exchanges_are_bounded() -> None:
+    history = [
+        ChatMessage(role="user", content="a" * 14000),
+        ChatMessage(role="assistant", tool_calls=[{"id": "old"}]),
+        ChatMessage(role="tool", content="old", tool_call_id="old"),
+        ChatMessage(role="user", content="Revisa el inventario"),
+    ]
+    messages = ContextBuilder().build(history, None, ["memory" * 4000])
+    assert messages[-1].content == "Revisa el inventario"
+    assert not any(message.role == "tool" for message in messages)
+    assert sum(len(message.model_dump_json()) for message in messages) < 14000
+
+
+def test_oversized_user_message_reports_limit_instead_of_overflow() -> None:
+    with pytest.raises(QError, match="supera el contexto"):
+        ContextBuilder().build([ChatMessage(role="user", content="a" * 30000)], None)
+
+
+def test_tool_excerpt_is_valid_json_and_explicitly_truncated() -> None:
+    result = ToolResult(request_id=uuid4(), status=ToolStatus.OK, data={"text": "a" * 50000})
+    encoded = _bounded_result(result)
+    assert len(encoded) < 6000
+    assert json.loads(encoded)["truncated"] is True
