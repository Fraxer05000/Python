+    if(video.current)video.current.srcObject=null;
+    setActive(false);setLoading(false);
+  };
+  useEffect(()=>()=>{
+    stop();
+    const loaded = model.current; model.current = null;
+    if (inFlight.current) void inFlight.current.catch(()=>undefined).then(()=>loaded?.dispose());
+    else loaded?.dispose();
+  },[]);
+  const start = async () => {
+    if (running.current || starting.current) return;
+    starting.current=true;
+    const current=++generation.current;
+    setLoading(true);setNotice("");setObjects([]);
+    try {
+      const media=await navigator.mediaDevices.getUserMedia({video:{width:{ideal:640},height:{ideal:480},frameRate:{ideal:10,max:15}},audio:false});
+      if(current!==generation.current){media.getTracks().forEach(t=>t.stop());return;}
+      stream.current=media;
+      if(!video.current)throw new Error("La vista de cámara no está disponible");
+      video.current.srcObject=media;await video.current.play();
+      await inFlight.current?.catch(()=>undefined);
+      await modelLoading.current?.catch(()=>undefined);
+      if(current!==generation.current)return;
+      if(!model.current){
+        const pending=(async()=>{
+          await import("@tensorflow/tfjs-backend-cpu");await import("@tensorflow/tfjs-backend-webgl");
+          const tf=await import("@tensorflow/tfjs-core");
+          try{if(!await tf.setBackend("webgl")) await tf.setBackend("cpu");}catch{await tf.setBackend("cpu");}await tf.ready();
+          const coco=await import("@tensorflow-models/coco-ssd");
+          const loaded=await coco.load({base:"lite_mobilenet_v2",modelUrl:"/vision/model.json"});
+          if(current!==generation.current)loaded.dispose();
