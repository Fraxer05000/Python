+// The server opens its port before loading the model. Only its authenticated
+// health response can establish readiness; each probe has a total time/byte cap.
+fn model_is_ready(port: u16, api_key: &str, timeout: Duration) -> std::io::Result<bool> {
+    let started = Instant::now();
+    let mut stream = TcpStream::connect_timeout(
+        &std::net::SocketAddr::from(([127, 0, 0, 1], port)),
+        timeout.min(Duration::from_millis(100)),
+    )?;
+    let remaining = timeout.saturating_sub(started.elapsed());
+    if remaining.is_zero() {
+        return Ok(false);
+    }
+    stream.set_write_timeout(Some(remaining))?;
+    write!(
+        stream,
+        "GET /health HTTP/1.0\r\nHost: 127.0.0.1:{port}\r\nAuthorization: Bearer {api_key}\r\nConnection: close\r\n\r\n"
+    )?;
+    let mut response = Vec::new();
+    let mut buffer = [0_u8; 1024];
+    loop {
+        let Some(remaining) = timeout
+            .checked_sub(started.elapsed())
+            .filter(|remaining| !remaining.is_zero())
+        else {
+            return Ok(false);
+        };
+        stream.set_read_timeout(Some(remaining))?;
+        let read = stream.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        if response.len() + read > MAX_HEALTH_RESPONSE_BYTES {
+            return Ok(false);
+        }
+        response.extend_from_slice(&buffer[..read]);
+    }
+    let Ok(response) = std::str::from_utf8(&response) else {
+        return Ok(false);
+    };
+    let Some((headers, body)) = response.split_once("\r\n\r\n") else {
+        return Ok(false);
+    };
+    let mut status = headers
+        .lines()
+        .next()
+        .unwrap_or("")
+        .split_ascii_whitespace();
+    if !matches!(status.next(), Some("HTTP/1.0" | "HTTP/1.1")) || status.next() != Some("200") {
+        return Ok(false);
+    }
+    let body = serde_json::from_str::<serde_json::Value>(body);
+    Ok(body
+        .is_ok_and(|value| value.get("status").and_then(serde_json::Value::as_str) == Some("ok")))
+}
