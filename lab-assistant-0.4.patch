--- /dev/null
+++ b/apps/backend/q_backend/controllers/devices.py
@@ -0,0 +1,80 @@
+"""Read-only Windows device discovery; no arbitrary driver or device commands."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+from q_backend.controllers.base import BaseController, ControllerResult
+from q_backend.errors import QError, QErrorCode
+from q_backend.models.permissions import InvocationIdentity
+
+_DISCOVERY = r"""
+$ErrorActionPreference='Stop'
+[Console]::OutputEncoding=[Text.UTF8Encoding]::new()
+@(Get-PnpDevice -PresentOnly | Where-Object {
+  $_.Class -in 'Bluetooth','Camera','Image','Ports','AudioEndpoint' -or
+  $_.InstanceId -like 'USB*'
+} | Select-Object Status,Class,FriendlyName,InstanceId) | ConvertTo-Json -Compress
+"""
+
+
+class DeviceController(BaseController):
+    def argument_schema(self, method: str) -> dict[str, Any]:
+        if method != "list":
+            raise QError(QErrorCode.VALIDATION_ERROR, "Unsupported device operation.")
+        return {"type": "object", "properties": {}, "additionalProperties": False}
+
+    async def invoke(
+        self,
+        method: str,
+        arguments: dict[str, Any],
+        identity: InvocationIdentity,
+    ) -> ControllerResult:
+        if method != "list":
+            raise QError(QErrorCode.VALIDATION_ERROR, "Unsupported device operation.")
+        return ControllerResult(data=await asyncio.to_thread(discover_devices), resource="devices")
+
+
+def discover_devices() -> dict[str, Any]:
+    if sys.platform != "win32":
+        return {"devices": [], "available": False, "detail": "Windows device discovery only."}
+    windows = Path(os.environ.get("SystemRoot", r"C:\Windows"))
+    executable = windows / "System32/WindowsPowerShell/v1.0/powershell.exe"
+    try:
+        result = subprocess.run(  # noqa: S603 - fixed executable and fixed script, no user arguments
+            [str(executable), "-NoProfile", "-NonInteractive", "-Command", _DISCOVERY],
+            capture_output=True,
+            timeout=20,
+            check=True,
+            creationflags=0x08000000,
+        )
+        rows = json.loads(result.stdout.decode("utf-8-sig"))
+    except (OSError, subprocess.SubprocessError, ValueError) as exc:
+        raise QError(
+            QErrorCode.RUNTIME_UNAVAILABLE, "No se pudo consultar los dispositivos."
+        ) from exc
+    if not isinstance(rows, list):
+        rows = [rows] if rows else []
+    devices = []
+    for row in rows[:300]:
+        category = str(row.get("Class", ""))
+        capability = {
+            "Camera": "Vista local y reconocimiento de objetos generales",
+            "AudioEndpoint": "Audio a través de los dispositivos de Windows",
+        }.get(category, "Detectado; requiere un adaptador y protocolo del fabricante para control")
+        devices.append(
+            {
+                "id": row.get("InstanceId"),
+                "name": row.get("FriendlyName"),
+                "category": category,
+                "status": row.get("Status"),
+                "capability": capability,
+            }
+        )
+    return {"devices": devices, "available": True}
