+from __future__ import annotations
+
+from typing import Any, cast
+from uuid import uuid4
+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from q_backend.config import Settings
+from q_backend.container import AppContainer
+from q_backend.main import create_app
+
+
+def invoke(
+    client: TestClient, tool: str, project: str | None, arguments: dict[str, Any] | None = None
+) -> dict[str, Any]:
+    result = client.post(
+        "/api/v1/tools/invoke",
+        json={
+            "request_id": str(uuid4()),
+            "tool": tool,
+            "arguments": arguments or {},
+            "reason": "Prueba de registro local",
+            "project_id": project,
+        },
+    )
+    assert result.status_code in (200, 409)
+    return cast(dict[str, Any], result.json())
+
+
+def confirm(client: TestClient, pending: dict[str, Any], allow: bool = True) -> dict[str, Any]:
+    assert pending["status"] == "confirmation_required"
+    result = client.post(
+        "/api/v1/permissions/confirm",
+        json={
+            "challenge_id": pending["data"]["challenge_id"],
+            "confirmation_secret": pending["data"]["confirmation_secret"],
+            "allow": allow,
+        },
+    )
+    return cast(dict[str, Any], result.json())
+
+
+def entry(**changes: Any) -> dict[str, Any]:
+    return {
+        "kind": "inventory",
+        "title": "Recipientes A",
+        "notes": "Conteo manual",
+        "source": "Usuario",
+        "status": "open",
+        "quantity": 4,
+        "minimum": 2,
+        "unit": "unidades",
+        **changes,
+    }
+
+
+def test_ledger_confirmation_isolation_history_and_restart(settings: Settings) -> None:
+    headers = {"Authorization": f"Bearer {settings.session_token}"}
+    with TestClient(create_app(settings), headers=headers) as client:
+        project = client.post("/api/v1/projects", json={"name": "Laboratorio A"}).json()[
+            "project_id"
+        ]
+        other = client.post("/api/v1/projects", json={"name": "Laboratorio B"}).json()["project_id"]
+        pending = invoke(client, "lab.record", project, entry())
+        assert invoke(client, "lab.list", project)["data"]["entries"] == []
+        confirm(client, pending, allow=False)
+        assert invoke(client, "lab.list", project)["data"]["entries"] == []
+        saved = confirm(client, invoke(client, "lab.record", project, entry()))
+        assert saved["status"] == "ok"
+        assert saved["audit_id"] and saved["provenance_id"]
+        updated = confirm(client, invoke(client, "lab.record", project, entry(quantity=1)))
+        assert updated["status"] == "ok"
+        assert invoke(client, "lab.list", other)["data"]["entries"] == []
+        memories = invoke(
+            client,
+            "memory.search",
+            project,
+            {"scope": "project", "query": "Recipientes A", "limit": 10},
+        )
+        assert any("Recipientes A" in item["record"]["content"] for item in memories["data"])
+    with TestClient(create_app(settings), headers=headers) as restarted:
+        records = invoke(restarted, "lab.list", project)["data"]["entries"]
+        assert [record["quantity"] for record in records] == [1, 4]
+        assert len({record["entry_id"] for record in records}) == 2
+
+
+def test_invalid_ledger_input_never_persists(client: TestClient) -> None:
+    project = client.post("/api/v1/projects", json={"name": "Validation"}).json()["project_id"]
+    assert invoke(client, "lab.record", None, entry())["status"] == "error"
+    assert invoke(client, "lab.record", project, entry(quantity=-1))["status"] == "error"
+    assert invoke(client, "lab.record", project, entry(unexpected="move"))["status"] == "error"
+    invalid_date = confirm(
+        client, invoke(client, "lab.record", project, entry(due_date="2026-02-30"))
+    )
+    assert invalid_date["status"] == "error"
+    assert invoke(client, "lab.list", project)["data"]["entries"] == []
+
+
+def test_model_receives_real_tool_argument_names(client: TestClient) -> None:
+    container = cast(AppContainer, cast(FastAPI, client.app).state.container)
+    contract = container.tools.model_tool_contract()
+    description = cast(dict[str, Any], contract["function"])["description"]
+    assert "lab.record(kind*:progress/inventory/equipment/observation" in description
+    assert "title*:string" in description
+    assert "devices.list()" in description
