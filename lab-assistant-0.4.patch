diff --git a/apps/desktop/src/voice.ts b/apps/desktop/src/voice.ts
new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/voice.ts
@@ -0,0 +1,31 @@
+import { useCallback, useEffect, useState } from "react";
+
+export function useQVoice() {
+  const [enabled, setEnabled] = useState(() => localStorage.getItem("q.voice.enabled") === "true");
+  const [voiceName, setVoiceName] = useState(() => localStorage.getItem("q.voice.name") ?? "");
+  const [voices, setVoices] = useState<SpeechSynthesisVoice[]>([]);
+  const [speaking, setSpeaking] = useState(false);
+  useEffect(() => {
+    if (!("speechSynthesis" in window)) return;
+    const update = () => setVoices(window.speechSynthesis.getVoices().filter(v => v.localService));
+    update();
+    window.speechSynthesis.addEventListener("voiceschanged", update);
+    return () => { window.speechSynthesis.removeEventListener("voiceschanged", update); window.speechSynthesis.cancel(); };
+  }, []);
+  useEffect(() => { localStorage.setItem("q.voice.enabled", String(enabled)); }, [enabled]);
+  useEffect(() => { localStorage.setItem("q.voice.name", voiceName); }, [voiceName]);
+  const stop = useCallback(() => { window.speechSynthesis?.cancel(); setSpeaking(false); }, []);
+  useEffect(() => { if (!enabled) stop(); }, [enabled, stop]);
+  const speak = useCallback((text: string, force = false) => {
+    if ((!enabled && !force) || !voices.length) return;
+    stop();
+    const utterance = new SpeechSynthesisUtterance(text.slice(0, 5000));
+    utterance.voice = voices.find(v => v.name === voiceName) ?? voices.find(v => v.lang.startsWith("es")) ?? voices[0];
+    utterance.lang = utterance.voice.lang;
+    utterance.rate = 0.97;
+    utterance.onstart = () => setSpeaking(true);
+    utterance.onend = utterance.onerror = () => setSpeaking(false);
+    window.speechSynthesis.speak(utterance);
+  }, [enabled, voices, voiceName, stop]);
+  return { enabled, setEnabled, voiceName, setVoiceName, voices, speaking, speak, stop };
+}
