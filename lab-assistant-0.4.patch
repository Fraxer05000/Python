diff --git a/scripts/verify_native_runtime.py b/scripts/verify_native_runtime.py
new file mode 100644
--- /dev/null
+++ b/scripts/verify_native_runtime.py
@@ -0,0 +1,171 @@
+"""Installed llama.cpp acceptance with a clean Windows PATH and actual inference."""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import json
+import os
+import secrets
+import socket
+import subprocess
+import time
+from pathlib import Path
+from urllib.error import URLError
+from urllib.request import Request, urlopen
+
+
+def verify(runtime: Path, model: Path, report: Path) -> None:
+    runtime, model = runtime.resolve(strict=True), model.resolve(strict=True)
+    report.parent.mkdir(parents=True, exist_ok=True)
+    token = secrets.token_hex(32)
+    environment = dict(os.environ)
+    windows = Path(os.environ.get("SystemRoot", r"C:\Windows"))
+    environment["PATH"] = f"{windows / 'System32'};{windows}"
+    with socket.socket() as listener:
+        listener.bind(("127.0.0.1", 0))
+        port = listener.getsockname()[1]
+
+    def request(path: str, payload: dict[str, object] | None = None) -> dict:
+        message = Request(
+            f"http://127.0.0.1:{port}{path}",
+            data=json.dumps(payload).encode() if payload is not None else None,
+            headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
+        )
+        with urlopen(message, timeout=180) as response:  # noqa: S310 - fixed loopback
+            return json.load(response)
+
+    # Report missing DLLs as exit codes instead of blocking CI with a modal OS dialog.
+    ctypes.windll.kernel32.SetErrorMode(0x0001 | 0x8000)
+    started = time.monotonic()
+    with report.with_suffix(".log").open("w", encoding="utf-8") as log:
+        process = subprocess.Popen(  # noqa: S603 - reviewed runtime and fixed arguments
+            [
+                str(runtime),
+                "--model",
+                str(model),
+                "--host",
+                "127.0.0.1",
+                "--port",
+                str(port),
+                "--ctx-size",
+                "8192",
+                "--parallel",
+                "1",
+                "--threads",
+                "4",
+                "--batch-size",
+                "256",
+                "--n-gpu-layers",
+                "0",
+                "--api-key",
+                token,
+            ],
+            cwd=runtime.parent,
+            env=environment,
+            stdout=log,
+            stderr=log,
+            creationflags=0x08000000,
+        )
+        try:
+            while time.monotonic() - started < 120:
+                if process.poll() is not None:
+                    raise RuntimeError(f"llama.cpp exit {process.returncode:#x}; see {log.name}")
+                try:
+                    if request("/health").get("status") == "ok":
+                        break
+                except (URLError, TimeoutError):
+                    pass
+                time.sleep(0.3)
+            else:
+                raise TimeoutError("Model readiness timeout")
+            ready = time.monotonic() - started
+            answer = request(
+                "/v1/chat/completions",
+                {
+                    "messages": [{"role": "user", "content": "Explica brevemente una bitácora."}],
+                    "max_tokens": 80,
+                    "temperature": 0,
+                },
+            )
+            if not answer["choices"][0]["message"].get("content"):
+                raise RuntimeError("Empty model response")
+            tool = {
+                "type": "function",
+                "function": {
+                    "name": "q_tool_request",
+                    "description": "Request system.resources.",
+                    "parameters": {
+                        "type": "object",
+                        "properties": {
+                            "request_id": {"type": "string"},
+                            "tool": {"type": "string", "enum": ["system.resources"]},
+                            "arguments": {"type": "object"},
+                            "reason": {"type": "string"},
+                            "project_id": {"type": ["string", "null"]},
+                        },
+                        "required": ["request_id", "tool", "arguments", "reason", "project_id"],
+                        "additionalProperties": False,
+                    },
+                },
+            }
+            action = request(
+                "/v1/chat/completions",
+                {
+                    "messages": [
+                        {
+                            "role": "user",
+                            "content": (
+                                "Request system.resources, request_id "
+                                "00000000-0000-4000-8000-000000000001, "
+                                "arguments {}, reason Verificar recursos, project_id null."
+                            ),
+                        }
+                    ],
+                    "tools": [tool],
+                    "tool_choice": "required",
+                    "temperature": 0,
+                    "max_tokens": 160,
+                },
+            )
+            calls = action["choices"][0]["message"].get("tool_calls", [])
+            if len(calls) != 1 or calls[0]["function"]["name"] != "q_tool_request":
+                raise RuntimeError("Model did not produce the canonical tool request")
+            arguments = json.loads(calls[0]["function"]["arguments"])
+            if arguments["tool"] != "system.resources" or arguments["arguments"] != {}:
+                raise RuntimeError("Unexpected controller request")
+            report.write_text(
+                json.dumps(
+                    {
+                        "status": "passed",
+                        "clean_system_path": True,
+                        "ready_seconds": round(ready, 3),
+                        "runtime": str(runtime),
+                        "model": str(model),
+                        "response": answer["choices"][0]["message"]["content"],
+                        "timings": answer.get("timings"),
+                        "tool_call": arguments,
+                    },
+                    ensure_ascii=False,
+                    indent=2,
+                ),
+                encoding="utf-8",
+            )
+        finally:
+            if process.poll() is None:
+                process.terminate()
+            try:
+                process.wait(timeout=20)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait(timeout=10)
+    print(f"Native runtime acceptance passed: {report}")
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--runtime", type=Path, required=True)
+    parser.add_argument("--model", type=Path, required=True)
+    parser.add_argument("--report", type=Path, required=True)
+    args = parser.parse_args()
+    verify(args.runtime, args.model, args.report)
