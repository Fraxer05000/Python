new file mode 100644
--- /dev/null
+++ b/scripts/prepare_vision_assets.py
@@ -0,0 +1,37 @@
+"""Fetch hash-pinned detector assets at build time; inference uses local files only."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+from urllib.request import urlopen
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def prepare() -> None:
+    manifest = json.loads((ROOT / "installer/vision-model.lock.json").read_text("utf-8"))
+    target = ROOT / "apps/desktop/public/vision"
+    target.mkdir(parents=True, exist_ok=True)
+    for item in manifest["files"]:
+        name, url = item["name"], item["url"]
+        if Path(name).name != name or not url.startswith(
+            "https://storage.googleapis.com/tfjs-models/savedmodel/ssdlite_mobilenet_v2/"
+        ):
+            raise ValueError("Unapproved vision asset path or source")
+        path = target / name
+        if path.is_file() and hashlib.sha256(path.read_bytes()).hexdigest() == item["sha256"]:
+            continue
+        with urlopen(url, timeout=120) as response:  # noqa: S310 - fixed HTTPS allowlist above
+            data = response.read(item["size"] + 1)
+        if len(data) != item["size"] or hashlib.sha256(data).hexdigest() != item["sha256"]:
+            raise ValueError(f"Vision asset integrity check failed: {name}")
+        temporary = path.with_suffix(".download")
+        temporary.write_bytes(data)
+        temporary.replace(path)
+    print("Local vision assets verified.")
+
+
+if __name__ == "__main__":
+    prepare()
