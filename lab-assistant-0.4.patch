+import { act, fireEvent, render, renderHook, screen, waitFor } from "@testing-library/react";
+import { afterEach, expect, test, vi } from "vitest";
+import { CameraView } from "./CameraView";
+import { useQVoice } from "./voice";
+import { useLocalMicrophone } from "./microphone";
+
+const detector = vi.hoisted(() => ({detect:vi.fn(), dispose:vi.fn(), load:vi.fn()}));
+vi.mock("@tensorflow-models/coco-ssd",()=>({load:detector.load}));
+vi.mock("@tensorflow/tfjs-core",()=>({setBackend:vi.fn().mockResolvedValue(true),ready:vi.fn()}));
+vi.mock("@tensorflow/tfjs-backend-cpu",()=>({}));
+vi.mock("@tensorflow/tfjs-backend-webgl",()=>({}));
+vi.mock("./api",()=>({invokeTool:vi.fn(),transcribeAudio:vi.fn().mockResolvedValue("Registro local")}));
+afterEach(()=>{vi.restoreAllMocks();vi.clearAllMocks();vi.unstubAllGlobals();localStorage.clear();});
+
+test("camera stops tracks and disposes after pending inference on unmount",async()=>{
+  const stop=vi.fn(); let finish!:(value:[])=>void;
+  const pending = new Promise<[]>(resolve=>{finish=resolve;});
+  detector.detect.mockReturnValue(pending);detector.dispose.mockClear();
+  detector.load.mockResolvedValue({detect:detector.detect,dispose:detector.dispose});
+  Object.defineProperty(navigator,"mediaDevices",{configurable:true,value:{getUserMedia:vi.fn().mockResolvedValue({getTracks:()=>[{stop}]})}});
+  vi.spyOn(HTMLMediaElement.prototype,"play").mockResolvedValue();
+  const view=render(<CameraView project={null} requestPermission={vi.fn()}/>);
+  fireEvent.click(screen.getByText("Activar cámara"));
+  await waitFor(()=>expect(detector.detect).toHaveBeenCalled());
+  expect(detector.load).toHaveBeenCalledWith({base:"lite_mobilenet_v2",modelUrl:"/vision/model.json"});
+  view.unmount();expect(stop).toHaveBeenCalledTimes(1);expect(detector.dispose).not.toHaveBeenCalled();
+  await act(async()=>{finish([]);await pending;});
+  await waitFor(()=>expect(detector.dispose).toHaveBeenCalledTimes(1));
+});
+
+test("late camera permission cannot leave capture open after navigation",async()=>{
+  let approve!:(stream:unknown)=>void;const stop=vi.fn();
+  Object.defineProperty(navigator,"mediaDevices",{configurable:true,value:{getUserMedia:()=>new Promise(resolve=>{approve=resolve;})}});
+  const view=render(<CameraView project={null} requestPermission={vi.fn()}/>);
+  fireEvent.click(screen.getByText("Activar cámara"));view.unmount();
+  await act(async()=>{approve({getTracks:()=>[{stop}]});});
+  expect(stop).toHaveBeenCalledTimes(1);
+});
+
+test("restarting during camera model loading cannot replace the new session's model",async()=>{
+  let finishFirst!:(value:unknown)=>void;let finishDetection!:(value:[])=>void;
+  const first={detect:vi.fn(),dispose:vi.fn()};
+  const pendingDetection=new Promise<[]>(resolve=>{finishDetection=resolve;});
+  const second={detect:vi.fn().mockReturnValue(pendingDetection),dispose:vi.fn()};
+  detector.load.mockReset().mockImplementationOnce(()=>new Promise(resolve=>{finishFirst=resolve;})).mockResolvedValueOnce(second);
+  const stop=vi.fn();
+  Object.defineProperty(navigator,"mediaDevices",{configurable:true,value:{getUserMedia:vi.fn().mockResolvedValue({getTracks:()=>[{stop}]})}});
+  const play=vi.spyOn(HTMLMediaElement.prototype,"play").mockResolvedValue();
+  const view=render(<CameraView project={null} requestPermission={vi.fn()}/>);
+  fireEvent.click(screen.getByText("Activar cámara"));
+  await waitFor(()=>expect(detector.load).toHaveBeenCalledTimes(1));
+  fireEvent.click(screen.getByText("Apagar cámara"));
+  fireEvent.click(screen.getByText("Activar cámara"));
+  await waitFor(()=>expect(play).toHaveBeenCalledTimes(2));
+  expect(detector.load).toHaveBeenCalledTimes(1);
+  await act(async()=>{finishFirst(first);});
+  await waitFor(()=>expect(second.detect).toHaveBeenCalledTimes(1));
+  expect(first.dispose).toHaveBeenCalledTimes(1);expect(first.detect).not.toHaveBeenCalled();
+  expect(second.dispose).not.toHaveBeenCalled();
+  view.unmount();
+  await act(async()=>{finishDetection([]);await pendingDetection;});
+  await waitFor(()=>expect(second.dispose).toHaveBeenCalledTimes(1));
+  expect(stop).toHaveBeenCalledTimes(2);
+});
+
+test("voice selects local Spanish synthesis and excludes remote voices",async()=>{
+  const local={name:"Q español local",lang:"es-ES",localService:true};
+  const remote={name:"Cloud",lang:"es-ES",localService:false};
+  const speak=vi.fn(),cancel=vi.fn();
+  vi.stubGlobal("speechSynthesis",{getVoices:()=>[remote,local],addEventListener:vi.fn(),removeEventListener:vi.fn(),speak,cancel});
+  vi.stubGlobal("SpeechSynthesisUtterance",class {constructor(public text:string){}});
+  const hook=renderHook(()=>useQVoice());
+  expect(hook.result.current.voices).toEqual([local]);
+  act(()=>hook.result.current.speak("Prueba de voz",true));
+  expect(speak.mock.calls[0][0].voice).toBe(local);
+  hook.unmount();expect(cancel).toHaveBeenCalled();
+});
+
+test("microphone captures at most sixty seconds and transcribes locally once",async()=>{
+  const {transcribeAudio}=await import("./api");
+  vi.mocked(transcribeAudio).mockResolvedValue("Registro local");
+  const stopTrack=vi.fn(),close=vi.fn().mockResolvedValue(undefined);
+  const processor={onaudioprocess:null as null|((e:unknown)=>void),connect:vi.fn(),disconnect:vi.fn()};
+  const source={connect:vi.fn(),disconnect:vi.fn()};
+  vi.stubGlobal("AudioContext",class {
+    sampleRate=16000;destination={};close=close;
+    createMediaStreamSource=()=>source;createScriptProcessor=()=>processor;
+    createGain=()=>({gain:{value:1},connect:vi.fn(),disconnect:vi.fn()});
+  });
+  Object.defineProperty(navigator,"mediaDevices",{configurable:true,value:{getUserMedia:vi.fn().mockResolvedValue({getTracks:()=>[{stop:stopTrack}]})}});
+  const text=vi.fn(); const hook=renderHook(()=>useLocalMicrophone({port:1234,token:"fixture"},text));
+  await act(async()=>{await hook.result.current.start();});
+  expect(hook.result.current.error).toBeNull();
+  await act(async()=>{processor.onaudioprocess?.({inputBuffer:{getChannelData:()=>new Float32Array(16000*65)}});});
+  expect(hook.result.current.error).toBeNull();
+  await waitFor(()=>expect(text).toHaveBeenCalledWith("Registro local"));
+  expect(vi.mocked(transcribeAudio).mock.calls[0][1].size).toBe(44+16000*60*2);
+  expect(stopTrack).toHaveBeenCalledTimes(1);expect(close).toHaveBeenCalledTimes(1);
+  hook.unmount();expect(stopTrack).toHaveBeenCalledTimes(1);
+});
+
+test("cancel discards dictation and pending transcription without sending to another project",async()=>{
+  const {transcribeAudio}=await import("./api");
+  let finish!:(value:string)=>void;
+  vi.mocked(transcribeAudio).mockImplementationOnce(()=>new Promise(resolve=>{finish=resolve;}));
+  const stopTrack=vi.fn();
+  const processor={onaudioprocess:null as null|((e:unknown)=>void),connect:vi.fn(),disconnect:vi.fn()};
+  vi.stubGlobal("AudioContext",class {
+    sampleRate=16000;destination={};close=vi.fn().mockResolvedValue(undefined);
+    createMediaStreamSource=()=>({connect:vi.fn(),disconnect:vi.fn()});createScriptProcessor=()=>processor;
+    createGain=()=>({gain:{value:1},connect:vi.fn(),disconnect:vi.fn()});
+  });
+  Object.defineProperty(navigator,"mediaDevices",{configurable:true,value:{getUserMedia:vi.fn().mockResolvedValue({getTracks:()=>[{stop:stopTrack}]})}});
+  const onText=vi.fn();const hook=renderHook(()=>useLocalMicrophone({port:1234,token:"fixture"},onText));
+  await act(async()=>{await hook.result.current.start();});
+  act(()=>{processor.onaudioprocess?.({inputBuffer:{getChannelData:()=>new Float32Array(4096)}});hook.result.current.cancel();});
+  expect(hook.result.current.recording).toBe(false);expect(transcribeAudio).not.toHaveBeenCalled();
+  await act(async()=>{await hook.result.current.start();});
+  act(()=>{processor.onaudioprocess?.({inputBuffer:{getChannelData:()=>new Float32Array(4096)}});void hook.result.current.stop();});
+  expect(hook.result.current.transcribing).toBe(true);
+  act(()=>hook.result.current.cancel());
+  await act(async()=>{finish("Texto del proyecto anterior");});
+  expect(onText).not.toHaveBeenCalled();expect(hook.result.current.transcribing).toBe(false);
+  expect(stopTrack).toHaveBeenCalledTimes(2);
+  hook.unmount();
+});
+
+test("cancel while microphone permission is pending releases any late stream",async()=>{
+  let approve!:(value:unknown)=>void;const stop=vi.fn();const onText=vi.fn();
+  Object.defineProperty(navigator,"mediaDevices",{configurable:true,value:{getUserMedia:()=>new Promise(resolve=>{approve=resolve;})}});
+  const hook=renderHook(()=>useLocalMicrophone({port:1234,token:"fixture"},onText));
+  act(()=>{void hook.result.current.start();});
+  act(()=>hook.result.current.cancel());
+  await act(async()=>{approve({getTracks:()=>[{stop}]});});
+  expect(stop).toHaveBeenCalledTimes(1);expect(onText).not.toHaveBeenCalled();
+  expect(hook.result.current.recording).toBe(false);hook.unmount();
+});
