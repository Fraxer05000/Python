+from __future__ import annotations
+
+import json
+
+import httpx
+import pytest
+from q_backend.models.lifecycle import LifecycleSnapshot, QState
+from q_backend.models.runtime import ChatMessage, InferenceRequest, RuntimeConnection
+from q_backend.runtimes.llama_cpp import LlamaCppAdapter
+from q_backend.supervisor.client import OfflineSupervisorClient
+
+
+class LocalSupervisor(OfflineSupervisorClient):
+    async def state(self) -> LifecycleSnapshot:
+        return LifecycleSnapshot(state=QState.ACTIVE)
+
+    async def runtime_connection(self) -> RuntimeConnection:
+        return RuntimeConnection(host="127.0.0.1", port=12345)
+
+
+@pytest.mark.asyncio
+async def test_nested_token_statistics_do_not_discard_model_response() -> None:
+    def respond(request: httpx.Request) -> httpx.Response:
+        assert request.url.host == "127.0.0.1"
+        assert json.loads(request.content)["temperature"] == 0.2
+        return httpx.Response(
+            200,
+            json={
+                "choices": [
+                    {"message": {"content": "Registro consultado"}, "finish_reason": "stop"}
+                ],
+                "usage": {
+                    "prompt_tokens": 10,
+                    "completion_tokens": 4,
+                    "total_tokens": 14,
+                    "prompt_tokens_details": {"cached_tokens": 0},
+                    "completion_tokens_details": None,
+                },
+            },
+        )
+
+    async with httpx.AsyncClient(transport=httpx.MockTransport(respond)) as client:
+        adapter = LlamaCppAdapter(LocalSupervisor(), client=client)
+        result = await adapter.generate(
+            InferenceRequest(
+                request_id="test",
+                messages=[ChatMessage(role="user", content="Consulta")],
+            )
+        )
+    assert result.content == "Registro consultado"
+    assert result.usage == {"prompt_tokens": 10, "completion_tokens": 4, "total_tokens": 14}
