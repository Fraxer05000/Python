+
+const names: Record<string,string> = { bottle:"botella", cup:"taza o recipiente", scissors:"tijeras", person:"persona", chair:"silla", "dining table":"mesa", laptop:"portátil", mouse:"ratón", keyboard:"teclado", book:"libro", "cell phone":"teléfono", tv:"pantalla", sink:"lavabo", refrigerator:"refrigerador", bowl:"recipiente" };
+export function CameraView({connection,project,requestPermission}: {connection?:BackendConnection;project:Project|null;requestPermission:PermissionHandler}) {
+  const video = useRef<HTMLVideoElement>(null);
+  const canvas = useRef<HTMLCanvasElement>(null);
+  const stream = useRef<MediaStream|null>(null);
+  const model = useRef<ObjectDetection|null>(null);
+  const modelLoading = useRef<Promise<void>|null>(null);
+  const running = useRef(false);
+  const starting = useRef(false);
+  const inFlight = useRef<Promise<DetectedObject[]> | null>(null);
+  const generation = useRef(0);
+  const timer = useRef<ReturnType<typeof setTimeout>|null>(null);
+  const [active,setActive] = useState(false);
