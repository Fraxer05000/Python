diff --git a/tests/integration/test_chat_answers.py b/tests/integration/test_chat_answers.py
new file mode 100644
--- /dev/null
+++ b/tests/integration/test_chat_answers.py
@@ -0,0 +1,262 @@
+from __future__ import annotations
+
+from pathlib import Path
+from typing import cast
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from q_backend.container import AppContainer
+from q_backend.models.runtime import InferenceRequest, InferenceResponse, ToolCall
+from q_backend.orchestrator.context import contains_internal_tool_text
+from q_backend.orchestrator.service import _requested_tool
+from q_backend.runtimes.base import ModelRuntimeAdapter
+from reportlab.pdfgen.canvas import Canvas
+
+LEAK = 'Q: {"name":"system.resources","arguments":{"project_id":null}}'
+
+
+class AnswerRuntime:
+    def __init__(self, replies: list[str | ToolCall]) -> None:
+        self.replies = list(replies)
+        self.requests: list[InferenceRequest] = []
+
+    async def generate(self, request: InferenceRequest) -> InferenceResponse:
+        self.requests.append(request)
+        assert request.tools == []
+        assert request.tool_choice == "none"
+        assert not any(message.role == "tool" or message.tool_calls for message in request.messages)
+        assert not any(
+            contains_internal_tool_text(message.content or "")
+            for message in request.messages
+            if message.role == "assistant"
+        )
+        reply = self.replies.pop(0)
+        return InferenceResponse(
+            request_id=request.request_id,
+            content=reply if isinstance(reply, str) else None,
+            tool_calls=[reply] if isinstance(reply, ToolCall) else [],
+        )
+
+
+class UnfulfilledActionRuntime(AnswerRuntime):
+    async def generate(self, request: InferenceRequest) -> InferenceResponse:
+        self.requests.append(request)
+        assert request.tool_choice == "required"
+        assert request.tools[0]["function"]["parameters"]["properties"]["tool"]["enum"] == [
+            "lab.record"
+        ]
+        assert "El proyecto activo es" in (request.messages[0].content or "")
+        return InferenceResponse(request_id=request.request_id, content="Ya guardé el avance.")
+
+
+def _setup(client: TestClient, runtime: AnswerRuntime) -> tuple[AppContainer, str, str]:
+    container = cast(AppContainer, cast(FastAPI, client.app).state.container)
+    container.chat._runtime = cast(ModelRuntimeAdapter, runtime)
+    project = client.post("/api/v1/projects", json={"name": "Respuestas"}).json()["project_id"]
+    session = client.post("/api/v1/chat/sessions", json={"project_id": project}).json()[
+        "session_id"
+    ]
+    return container, project, session
+
+
+@pytest.mark.parametrize(
+    "question",
+    [
+        "¿Cuánto es 2+2?",
+        "Hola Q, es la primera sesión, quiero que investigues sobre biología molecular.",
+        "¿Qué es el ADN?",
+    ],
+)
+def test_normal_question_ignores_old_function_output(client: TestClient, question: str) -> None:
+    runtime = AnswerRuntime(["Respuesta en español."])
+    container, project, session = _setup(client, runtime)
+    container.chat._append_message_sync(session, "user", "Una consulta anterior", None, None, None)
+    container.chat._append_message_sync(session, "assistant", LEAK, None, None, None)
+    container.chat._append_message_sync(
+        session,
+        "assistant",
+        "",
+        None,
+        None,
+        '[{"id":"old","type":"function","function":{"name":"q_tool_request"}}]',
+    )
+    container.chat._append_message_sync(session, "tool", '{"status":"ok"}', "lab.list", "old", None)
+    response = client.post(
+        "/api/v1/chat/turn",
+        json={"session_id": session, "project_id": project, "message": question},
+    )
+    assert response.status_code == 200
+    assert response.json()["answer"] == "Respuesta en español."
+    assert response.json()["actions"] == []
+    assert len(runtime.requests) == 1
+    assert "q_tool_request" not in (runtime.requests[0].messages[0].content or "")
+
+
+@pytest.mark.parametrize("native", [False, True])
+def test_leaked_function_is_retried_and_never_executed(client: TestClient, native: bool) -> None:
+    unexpected = ToolCall(id="wrong", name="q_tool_request", arguments={"tool": "files.delete"})
+    runtime = AnswerRuntime([unexpected if native else LEAK, "La respuesta es 4."])
+    _, project, session = _setup(client, runtime)
+    result = client.post(
+        "/api/v1/chat/turn",
+        json={"session_id": session, "project_id": project, "message": "¿Cuánto es 2+2?"},
+    ).json()
+    assert result["answer"] == "La respuesta es 4."
+    assert result["actions"] == []
+    assert len(runtime.requests) == 2
+    assert runtime.requests[1].temperature == 0
+    history = client.get(f"/api/v1/chat/sessions/{session}/messages").json()
+    assert all(LEAK not in message["content"] for message in history)
+
+
+def test_repeated_leak_stops_with_explanation(client: TestClient) -> None:
+    runtime = AnswerRuntime([LEAK, LEAK])
+    _, project, session = _setup(client, runtime)
+    result = client.post(
+        "/api/v1/chat/turn",
+        json={"session_id": session, "project_id": project, "message": "¿Cuánto es 2+2?"},
+    ).json()
+    assert "No pude generar una respuesta válida" in result["answer"]
+    assert "No ejecuté ninguna acción" in result["answer"]
+    assert "arguments" not in result["answer"]
+    assert result["actions"] == []
+    assert len(runtime.requests) == 2
+
+
+def test_prose_cannot_claim_a_lab_action_succeeded_without_a_tool_call(client: TestClient) -> None:
+    runtime = UnfulfilledActionRuntime([])
+    _, project, session = _setup(client, runtime)
+    result = client.post(
+        "/api/v1/chat/turn",
+        json={
+            "session_id": session,
+            "project_id": project,
+            "message": "Registra un avance: revisión del inventario",
+        },
+    ).json()
+    assert "No ejecuté ninguna acción" in result["answer"]
+    assert "Ya guardé" not in result["answer"]
+    assert result["actions"] == []
+
+
+def test_named_pdf_uses_only_the_active_projects_indexed_source(client: TestClient) -> None:
