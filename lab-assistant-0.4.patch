+import pytest
+from q_backend.controllers.devices import discover_devices
+from q_backend.errors import QError
+
+
+def test_discovery_uses_fixed_read_only_query() -> None:
+    output = json.dumps(
+        [
+            {
+                "Class": "Ports",
+                "FriendlyName": "COM3",
+                "InstanceId": "BTHENUM/example",
+                "Status": "OK",
+            }
+        ]
+    ).encode()
+    with (
+        patch("q_backend.controllers.devices.sys.platform", "win32"),
+        patch(
+            "q_backend.controllers.devices.subprocess.run",
